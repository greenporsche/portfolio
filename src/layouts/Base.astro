---
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Siddharth Krishna: research in math and machine learning, and software I build.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400;62..125,500;62..125,800;62..125,900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="wrap">
      <slot />
    </main>
    <!-- Visitor analytics: one report per full page load, live site only. /v is forwarded by vercel.json. -->
    <script is:inline>if (location.hostname === 'portfolio.siddharthkrishna.com') navigator.sendBeacon("/v", JSON.stringify({ host: location.hostname, path: location.pathname + location.search, ref: document.referrer }));</script>
  </body>
</html>
